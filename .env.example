# ==============================================================================
# BATKHELA MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT commit real secrets, private keys, or credentials to Git.
# Duplicate this file as `.env` for local development.

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Google Maps / Location APIs (Optional / Future) ---
GOOGLE_MAPS_API_KEY_ANDROID=your-google-maps-android-key-here
GOOGLE_MAPS_API_KEY_WEB=your-google-maps-web-key-here

# --- Firebase / Push Notifications (Optional / Future) ---
FIREBASE_PROJECT_ID=batkhela-marketplace
FIREBASE_MESSAGING_SENDER_ID=123456789012
